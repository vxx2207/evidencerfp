# EvidenceRFP – lokale Beispielkonfiguration
# Kopiere diese Datei nach .env. Niemals echte Secrets committen.

# PostgreSQL / pgvector
POSTGRES_DB=evidence_rfp
POSTGRES_USER=evidence_rfp
POSTGRES_PASSWORD=evidence_rfp
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/evidence_rfp
DATABASE_USER=evidence_rfp
DATABASE_PASSWORD=evidence_rfp

# Backend und Browser
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# KI: deterministic-demo ist der sichere Start ohne Modell.
# Für Ollama zusätzlich Maven- und Spring-Profil `ollama` aktivieren.
AI_PROVIDER=deterministic-demo
AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=bge-m3

# Optional statt Ollama: Maven-/Spring-Profil `openai` explizit aktivieren.
# Dokumentinhalte verlassen dann die lokale Umgebung.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_PORT=11434

# Frontend: demo lädt nur statische synthetische Fixtures, api spricht mit dem Backend.
VITE_APP_MODE=demo
VITE_API_BASE_URL=http://localhost:8080
